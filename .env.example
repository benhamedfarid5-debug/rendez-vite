# ---------------------------------------------------------------------------
# Mawid — exemple de configuration. Copier en .env puis adapter.
# AUCUNE clé réelle n'est fournie : les intégrations restent désactivées.
# ---------------------------------------------------------------------------

# Serveur
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Base de données locale (SQLite)
DATABASE_FILE=data/mawid.db

# URL publique utilisée pour générer les QR codes et liens de partage
# Laisser vide pour utiliser l’hôte de la requête (recommandé en local et en prévisualisation)
PUBLIC_BASE_URL=

# Sécurité
# Obligatoire en production : chaîne aléatoire longue (>= 32 caractères)
IP_HASH_SALT=change-me-random-salt
# Validité du lien de gestion patient après le rendez-vous (jours)
MANAGE_LINK_GRACE_DAYS=30
# Multiplicateur des limites de débit (1 en production ; 3 en démonstration)
RATE_LIMIT_FACTOR=3
# Durée de vie des sessions (heures)
SESSION_TTL_HOURS=12
# Forcer le cookie Secure même hors production (HTTPS obligatoire)
COOKIE_SECURE=0
# Origines supplémentaires autorisées (séparées par des virgules)
ALLOWED_ORIGINS=

# Mot de passe des comptes de démonstration (fictif)
DEMO_PASSWORD=Demo2026!dent
# 0 = masquer les bandeaux « mode démonstration »
DEMO_MODE=1
# Mode test : réservation possible chez tous les dentistes de l annuaire (mettre 0 avant la mise en ligne)
TEST_ALL_BOOKABLE=1

# ---------------------------------------------------------------------------
# Notifications — laissées VIDES volontairement.
# Tant qu'elles sont vides, les messages sont seulement journalisés/simulés :
# aucun e-mail, SMS ou WhatsApp n'est réellement envoyé.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SMS via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_SENDER=

WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Nom du modèle WhatsApp approuvé par Meta (un paramètre {{1}}), facultatif
WHATSAPP_TEMPLATE=

# ---------------------------------------------------------------------------
# Traduction automatique optionnelle du texte libre (désactivée par défaut).
# Aucun texte patient ne doit être transmis à un tiers sans consentement
# explicite du patient et validation juridique.
# ---------------------------------------------------------------------------
TRANSLATION_ENABLED=0
TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=

# Paiement des abonnements (Edahabia / CIB) via Chargily Pay
# Clé secrète du compte marchand Chargily (test_sk_… en test, live_sk_… en réel).
# Sans clé : paiement simulé (démonstration uniquement).
CHARGILY_SECRET_KEY=
# Test : https://pay.chargily.net/test/api/v2 — Réel : l'adresse « live » indiquée par Chargily
CHARGILY_API_BASE=https://pay.chargily.net/test/api/v2

# Paiement par téléphone (option discrète) : numéro affiché aux médecins
PAY_PHONE=0561 70 55 12

# Espace administrateur (/admin) : création des codes d'activation, liste des cabinets
# OBLIGATOIRE avant la mise en ligne (sinon l'espace admin est désactivé).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Factures : informations du vendeur (XXXX tant que ce n'est pas rempli)
SELLER_NAME=
SELLER_ADDRESS=
SELLER_NIF=
SELLER_NIS=
SELLER_AE_CARD=
SELLER_EMAIL=
# Mention légale en bas de facture (à demander au comptable), facultatif
SELLER_MENTION=
# L'envoi des factures par e-mail utilise SMTP_HOST / SMTP_USER / SMTP_PASSWORD (ex. Gmail : smtp.gmail.com, port 465, mot de passe d'application)
